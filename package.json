{
  "name": "note-to-powerpoint",
  "version": "0.2.0",
  "private": true,
  "description": "Obsidian plugin: export a note as an editable PowerPoint deck.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sample": "node scripts/sample.mjs"
  },
  "dependencies": {
    "markdown-it": "^14.3.3",
    "pptxgenjs": "^4.0.1"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "jszip": "^3.10.1",
    "obsidian": "^1.14.4",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "image-size": "^2.0.3"
  }
}
